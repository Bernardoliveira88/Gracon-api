# Banco de dados PostgreSQL (Docker)
DATABASE_URL="postgresql://postgres:rootpassword@localhost:5432/nexusdoc?schema=public"

# Chave secreta para assinar tokens JWT (mínimo 32 caracteres)
JWT_SECRET="troque-por-uma-chave-segura-com-pelo-menos-32-caracteres"

# Chave de API do Google AI Studio (Gemini)
GEMINI_API_KEY=""

# Chave de API do Resend (envio de e-mails)
RESEND_API_KEY=""

# Porta do servidor (padrão: 3000)
PORT=3000

# Ambiente (development | production | test)
NODE_ENV=development

# URL do frontend (usada na configuração de CORS)
FRONTEND_URL=http://localhost:3001